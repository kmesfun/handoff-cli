@@ -0,0 +1,12 @@
+"""Add last_login column to users"""
+from alembic import op
+import sqlalchemy as sa
+
+def upgrade():
+    op.add_column('users', sa.Column('last_login', sa.DateTime(), nullable=True))
+
+def downgrade():
+    op.drop_column('users', 'last_login')
